# iOS release lanes (#51). Auth via an App Store Connect API key (no 2FA);
# code-signing via `match` (a shared signing repo). All inputs come from env so
# nothing sensitive lives in the repo. Run from the `ios/` directory:
#   bundle exec fastlane beta
default_platform(:ios)

platform :ios do
  desc "Build and upload a TestFlight build"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )

    # Fetch the distribution cert + provisioning profile (read-only in CI).
    if ENV["MATCH_GIT_URL"]
      match(
        type: "appstore",
        readonly: true,
        app_identifier: ENV["IOS_APP_IDENTIFIER"] || "de.quavon.surveyschool",
        git_url: ENV["MATCH_GIT_URL"],
        api_key: api_key
      )
    end

    build_app(
      project: "App/App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      output_directory: "build",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
