# NOTE: The values below are LOCAL DEV defaults. In production every secret
# (DB_PASSWORD, KEYCLOAK_CLIENT_SECRET, KEYCLOAK_ADMIN_PASSWORD, MINIO_SECRET_KEY,
# SURVEY_SPAM_SECRET) MUST be set to a strong, unique value — the backend has no
# production fallback for them and will refuse to boot if they are unset.

# Database Configuration
DB_USERNAME=survey
# REQUIRED in production (no fallback).
DB_PASSWORD=survey
DB_HOST=localhost
DB_PORT=5432
DB_NAME=survey
DB_GENERATION=drop-and-create

# HTTP & CORS
HTTP_PORT=8080
CORS_ORIGINS=http://localhost:3000
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=Authorization,Content-Type
CORS_EXPOSED_HEADERS=Set-Cookie
CORS_ALLOW_CREDENTIALS=true

# Keycloak / OIDC
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=survey-school
KEYCLOAK_CLIENT_ID=survey-backend
# REQUIRED in production (no fallback).
KEYCLOAK_CLIENT_SECRET=secret
KEYCLOAK_ADMIN_USERNAME=admin
# REQUIRED in production (no fallback).
KEYCLOAK_ADMIN_PASSWORD=admin

# Application
APP_BASE_URL=http://localhost:3000


# MinIO / S3
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
# REQUIRED in production (no fallback).
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=survey
MINIO_REGION=us-east-1

# Spam & bot protection (issue #31): HMAC secret that signs begin-tokens and
# Altcha challenges. REQUIRED in production (no fallback) — use a long random value.
SURVEY_SPAM_SECRET=change-me-spam-secret

# Rate limiting (issue #42): "memory" (per-instance, default) or "redis" (shared).
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://localhost:6379

# Upload virus scanning (issue #43): enable to route uploads through clamd.
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_FAIL_OPEN=false
